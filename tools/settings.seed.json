{
    // === СКРУГЛЕНИЕ БОЛЬШИХ ЧАСТЕЙ (2026-10-14, v2.9.11) ===
    // НАТИВНЫЙ режим VS Code 1.135: боковые панели и нижняя панель become
    // «плавающими карточками» со скруглениями и зазорами (как Agents window).
    // Радиусы берутся из нативных токенов --vscode-cornerRadius-*
    // (small 4 / medium 6 / large 8 / xLarge 12 px), цвет — из темы.
    // Раньше скругления навязывались CSS-инъекцией в WebView лаунчера
    // (.monaco-workbench > .part.*) — селектор НЕ матчился (части не прямые
    // дети), поэтому «скругление не работало». Эта настройка — штатный путь.
    "workbench.experimental.modernUI": true,
    // ================= Чистота и скорость =================
    "workbench.startupEditor": "none",
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "breadcrumbs.enabled": false,
    "editor.smoothScrolling": false,
    // Без анимаций интерфейса — на WebView они дают лишние композитные
    // перерисовки (2.6, антилаг; откат: "off" или "auto").
    "workbench.reduceMotion": "on",
    "workbench.enableExperiments": false,
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "extensions.autoUpdate": "off",

    // --- Терминал ---
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.initialHint": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.smoothScrolling": false,

    // --- Рабочие мелочи ---
    "explorer.confirmDelete": false,
    "security.workspace.trust.untrustedFiles": "open",
    "cSpell.language": "en,ru",
    "chat.viewSessions.orientation": "stacked",
    "chat.unifiedAgentsBar.enabled": true,
    "workbench.activityBar.location": "top",

    // === Оформление (design) ===
    // Матовая прозрачность окон/диалогов и единый красно-розовый курсор
    // #FF2D55 (как и его след) заданы ниже в workbench.colorCustomizations —
    // работают ПОВЕРХ любой темы. Саму тему не навязываем: выбери сам
    // (Ctrl+K Ctrl+T); оформление ляжет поверх.
    "editor.fontFamily": "MiSans, -apple-system, sans-serif",
    "editor.fontLigatures": false,
    "terminal.integrated.fontFamily": "Droid Sans Mono",

    // === Матовая прозрачность диалогов/окон во всех темах + единый курсор #FF2D55 ===
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#FF2D55",
        "editorMultiCursor.primary.foreground": "#FF2D55",
        "editorMultiCursor.secondary.foreground": "#FF2D55",
        "terminalCursor.foreground": "#FF2D55",
        "sideBar.background": "#F2F2F7D4",
        "sideBar.foreground": "#1D1D1F",
        "sideBar.border": "#C7C7CC80",
        "sideBarTitle.background": "#00000000",
        "sideBarTitle.foreground": "#1D1D1F",
        "sideBarSectionHeader.background": "#E5E5EA73",
        "sideBarSectionHeader.foreground": "#1D1D1F",
        "sideBarSectionHeader.border": "#C7C7CC66",
        "activityBar.background": "#E5E5EAD4",
        "activityBar.foreground": "#1D1D1F",
