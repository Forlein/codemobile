        "chat.editedFileForeground": "#0A5FC0",
        "inlineChat.background": "#F2F2F7D9",
        "inlineChat.foreground": "#1D1D1F",
        "inlineChat.border": "#C7C7CC99",
        "inlineChatInput.background": "#E5E5EACC",
        "inlineChatInput.border": "#C7C7CC",
        "inlineChatInput.focusBorder": "#007AFF",
